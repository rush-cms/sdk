---
import type { VideoBlock } from '@rushcms/types'

interface Props {
	block: VideoBlock
	class?: string
}

const { block, class: className } = Astro.props

const aspectStyle = block.data.aspect_ratio !== 'auto'
	? `aspect-ratio: ${block.data.aspect_ratio}`
	: undefined
---

<figure class:list={['w-full max-w-4xl mx-auto', className]}>
	<div class='relative overflow-hidden rounded-lg' style={aspectStyle}>
		<video
			src={block.data.video}
			poster={block.data.poster}
			controls={block.data.controls}
			autoplay={block.data.autoplay}
			loop={block.data.loop}
			muted={block.data.muted}
			class='w-full h-full'
		>
			Your browser does not support the video tag.
		</video>
	</div>
	{block.data.caption && (
		<figcaption class='text-sm text-gray-600 mt-2 text-center'>
			{block.data.caption}
		</figcaption>
	)}
</figure>
