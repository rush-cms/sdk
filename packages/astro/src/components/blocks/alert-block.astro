---
import type { AlertBlock } from '@rushcms/types'
import { tiptapToHtml } from '../../utils/tiptap-to-html'

interface Props {
	block: AlertBlock
	class?: string
}

const { block, class: className } = Astro.props

const html = tiptapToHtml(block.data.content)

const alertConfig: Record<string, { container: string; iconPath: string }> = {
	info: {
		container: 'bg-blue-50 border-blue-500',
		iconPath: 'M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z'
	},
	success: {
		container: 'bg-green-50 border-green-500',
		iconPath: 'M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z'
	},
	warning: {
		container: 'bg-yellow-50 border-yellow-500',
		iconPath: 'M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z'
	},
	error: {
		container: 'bg-red-50 border-red-500',
		iconPath: 'M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z'
	}
}

const config = alertConfig[block.data.type] || alertConfig.info
const iconColorMap: Record<string, string> = {
	info: 'text-blue-500',
	success: 'text-green-500',
	warning: 'text-yellow-500',
	error: 'text-red-500'
}
const iconColor = iconColorMap[block.data.type] || 'text-blue-500'
---

<div class:list={['border-l-4 p-4 rounded-r-lg', config.container, className]}>
	<div class='flex gap-3'>
		<div class='flex-shrink-0'>
			<svg class:list={['w-5 h-5', iconColor]} fill='currentColor' viewBox='0 0 20 20'>
				<path fill-rule='evenodd' d={config.iconPath} clip-rule='evenodd' />
			</svg>
		</div>
		<div class='flex-1 min-w-0'>
			{block.data.title && (
				<h4 class='font-semibold mb-1'>{block.data.title}</h4>
			)}
			<div set:html={html} />
		</div>
	</div>
</div>
