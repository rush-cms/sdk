---
import type { ColumnsBlock } from '@rushcms/types'
import { tiptapToHtml } from '../../utils/tiptap-to-html'

interface Props {
	block: ColumnsBlock
	class?: string
}

const { block, class: className } = Astro.props

if (!block.data.items || block.data.items.length === 0) return null

const gapClasses: Record<string, string> = {
	small: 'gap-4',
	medium: 'gap-6',
	large: 'gap-8'
}

const gridCols = block.data.columns === 2 ? 'md:grid-cols-2' : 'md:grid-cols-3'
const gapClass = gapClasses[block.data.gap] || 'gap-6'
---

<div class:list={['grid grid-cols-1', gridCols, gapClass, className]}>
	{block.data.items.map((item) => (
		<div class='min-w-0' set:html={tiptapToHtml(item.content)} />
	))}
</div>
