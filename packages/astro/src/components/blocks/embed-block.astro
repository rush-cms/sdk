---
import type { EmbedBlock } from '@rushcms/types'

interface Props {
	block: EmbedBlock
	class?: string
}

const { block, class: className } = Astro.props

const aspectStyle = block.data.aspect_ratio !== 'auto'
	? `aspect-ratio: ${block.data.aspect_ratio}`
	: 'aspect-ratio: 16/9'
---

<figure class:list={['w-full max-w-4xl mx-auto', className]}>
	<div class='relative overflow-hidden rounded-lg' style={aspectStyle}>
		<iframe
			src={block.data.url}
			title={block.data.title || 'Embedded content'}
			allowfullscreen={block.data.allow_fullscreen || undefined}
			class='absolute inset-0 w-full h-full border-0'
		/>
	</div>
	{block.data.title && (
		<figcaption class='text-sm text-gray-600 mt-2 text-center'>
			{block.data.title}
		</figcaption>
	)}
</figure>
