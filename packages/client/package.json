{
  "name": "@rushcms/client",
  "version": "2.0.1",
  "description": "TypeScript API client for RushCMS",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rush-cms/sdk.git",
    "directory": "packages/client"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "clean": "rm -rf dist",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "keywords": [
    "rushcms",
    "api",
    "client",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "@rushcms/types": "2.0.0"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.3"
  },
  "gitHead": "d68939deaad7e7061645209169b982874defe128"
}
